# Repository that NightShift is allowed to change.
APPROVED_REPOSITORY=your-github-owner/your-demo-repository

# Use a high-entropy value; GitHub uses it to sign webhook deliveries.
WEBHOOK_SECRET=replace-me

# Required when the production GitHub App adapter is enabled.
# GitHub recommends the Client ID as the GitHub App JWT issuer.
GITHUB_APP_CLIENT_ID=Iv23li6pKOo2oVhF7q8N
GITHUB_APP_ID=4538142
GITHUB_APP_PRIVATE_KEY_PATH=.secrets/nightshift-github-app.pem
